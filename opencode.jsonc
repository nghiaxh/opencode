{
  "$schema": "https://opencode.ai/config.json",
  "shell": "pwsh",
  "share": "disabled",
  "autoupdate": "notify",
  "lsp": true,
  "formatter": true,
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": ["~/.config/opencode/skills"],
  },
  "watcher": {
    "ignore": ["node_modules", ".git", "dist", "build", ".next", "*.min.*"],
  },
}
