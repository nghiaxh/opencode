{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "cursor"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "grouping": "auto",
    "image_preview": false,
    "permissions": "prompt"
  },
  "animations": true,
  "attention": {
    "notifications": false,
    "sound": false
  },
  "terminal": {
    "title": true
  },
  "debug": {
    "devtools": false
  }
}
