{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "lsp": true,
  "formatter": true,
  "instructions": ["AGENTS.md", "PERSONAL.md"],
  "skills": {
    "paths": ["~/.config/opencode/skills"]
  },
  "permission": {
    "external_directory": {
      "~/AppData/Local/Temp/*": "allow",
      "*": "ask"
    }
  }
}
